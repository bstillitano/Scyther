    "This will crash the app. Reopen it to see the crash log in Scyther → System Tools → Crash Logs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى تعطل التطبيق. أعد فتحه لعرض السجل في Scyther → أدوات النظام → سجلات الأعطال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies lässt die App abstürzen. Öffnen Sie sie erneut, um das Protokoll unter Scyther → Systemwerkzeuge → Absturzprotokolle zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will crash the app. Reopen it to see the crash log in Scyther → System Tools → Crash Logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto hará que la app falle. Vuelva a abrirla para ver el registro en Scyther → Herramientas del sistema → Registros de fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fera planter l'app. Rouvrez-la pour voir le rapport dans Scyther → Outils système → Journaux de plantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app andrà in crash. Riaprila per vedere il log in Scyther → Strumenti di sistema → Log dei crash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがクラッシュします。再度開くと、Scyther → システムツール → クラッシュログでログを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 충돌합니다. 다시 열면 Scyther → 시스템 도구 → 충돌 로그에서 로그를 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdoor crasht de app. Open de app opnieuw om het logboek te zien in Scyther → Systeemhulpmiddelen → Crashlogboeken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso fará o app falhar. Reabra-o para ver o registro em Scyther → Ferramentas do sistema → Registros de falhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение аварийно завершится. Откройте его снова, чтобы увидеть отчёт в Scyther → Системные инструменты → Журналы сбоев."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会让 App 崩溃。重新打开后可在 Scyther → 系统工具 → 崩溃日志中查看日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會讓 App 當機。重新開啟後可在 Scyther → 系統工具 → 當機記錄中查看記錄。"
          }
        }
      }
    },
