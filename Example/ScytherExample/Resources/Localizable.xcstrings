    "Calls https://graphqlzero.almansi.me. Open Scyther → Networking → Network Logs to see the operation name and type.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستدعي https://graphqlzero.almansi.me. افتح Scyther → الشبكة → سجلات الشبكة لعرض اسم العملية ونوعها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft https://graphqlzero.almansi.me auf. Öffnen Sie Scyther → Netzwerk → Netzwerkprotokolle, um Name und Typ der Operation zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls https://graphqlzero.almansi.me. Open Scyther → Networking → Network Logs to see the operation name and type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama a https://graphqlzero.almansi.me. Abra Scyther → Redes → Registros de red para ver el nombre y el tipo de la operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelle https://graphqlzero.almansi.me. Ouvrez Scyther → Réseau → Journaux réseau pour voir le nom et le type de l'opération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiama https://graphqlzero.almansi.me. Apri Scyther → Rete → Log di rete per vedere il nome e il tipo dell'operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "https://graphqlzero.almansi.meを呼び出します。操作名と種類を確認するには、Scyther → ネットワーク → ネットワークログを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https://graphqlzero.almansi.me를 호출합니다. 작업 이름과 유형을 확인하려면 Scyther → 네트워크 → 네트워크 로그를 여십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roept https://graphqlzero.almansi.me aan. Open Scyther → Netwerk → Netwerklogboeken om de naam en het type van de bewerking te zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chama https://graphqlzero.almansi.me. Abra Scyther → Rede → Registros de rede para ver o nome e o tipo da operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обращается к https://graphqlzero.almansi.me. Откройте Scyther → Сеть → Сетевые журналы, чтобы увидеть имя и тип операции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调用 https://graphqlzero.almansi.me。打开 Scyther → 网络 → 网络日志即可查看操作名称和类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "呼叫 https://graphqlzero.almansi.me。開啟 Scyther → 網路 → 網路記錄即可查看操作名稱與類型。"
          }
        }
      }
    },
