    "Contrast ratios are estimated by sampling pixels on screen, not measured from exact colors.": {
      "comment": "Footer under the Contrast section of the accessibility audit report screen, noting that its findings are estimates rather than exact measurements",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تقدير نسب التباين عن طريق أخذ عينات من وحدات البكسل على الشاشة، وليس قياسها من الألوان الدقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrastverhältnisse werden durch Stichproben von Bildschirmpixeln geschätzt, nicht anhand exakter Farbwerte gemessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las relaciones de contraste se estiman muestreando píxeles en pantalla, no se miden a partir de colores exactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les ratios de contraste sont estimés en échantillonnant des pixels à l'écran, et non mesurés à partir des couleurs exactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I rapporti di contrasto sono stimati campionando i pixel sullo schermo, non misurati a partire dai colori esatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コントラスト比は画面上のピクセルをサンプリングして推定した値であり、正確な色から測定したものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명암비는 화면의 픽셀을 샘플링하여 추정한 값이며, 정확한 색상으로 측정한 것이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contrastverhoudingen worden geschat door pixels op het scherm te bemonsteren, niet gemeten op basis van exacte kleuren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As taxas de contraste são estimadas por amostragem de pixels na tela, não medidas a partir de cores exatas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коэффициенты контрастности оцениваются по выборке пикселей на экране, а не измеряются по точным цветам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对比度是通过采样屏幕像素估算得出的，并非根据精确颜色测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "對比度是透過取樣螢幕像素估算得出的，並非根據精確顏色測量。"
          }
        }
      }
    },
