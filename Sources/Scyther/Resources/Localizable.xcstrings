    "Point size unknown, so the large-text allowance was not applied.": {
      "comment": "Appended to a contrast finding when the element could not report the point size of its text, so WCAG's relaxed large-text threshold of 3:1 was withheld and the strict 4.5:1 used instead.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حجم الخط غير معروف، لذلك لم يُطبَّق تخفيف النص الكبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schriftgröße unbekannt, daher wurde die Ausnahme für großen Text nicht angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tamaño de fuente desconocido, así que no se aplicó la excepción para texto grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taille de police inconnue : la tolérance pour le grand texte n'a pas été appliquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corpo del testo sconosciuto, quindi la tolleranza per il testo grande non è stata applicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字サイズが不明なため、大きな文字の緩和基準は適用していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "글자 크기를 알 수 없어 큰 텍스트 완화 기준을 적용하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puntgrootte onbekend, dus de uitzondering voor grote tekst is niet toegepast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tamanho da fonte desconhecido, então a tolerância para texto grande não foi aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Размер шрифта неизвестен, поэтому послабление для крупного текста не применялось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "字号未知，因此未应用大号文本的放宽标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "字級未知，因此未套用大型文字的放寬標準。"
          }
        }
      }
