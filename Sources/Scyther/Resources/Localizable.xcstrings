    "Accessibility sizes may cause layout issues in apps not designed for them.": {
      "comment": "Warning shown when an accessibility text size is selected",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد تسبب أحجام إمكانية الوصول مشكلات في التخطيط داخل التطبيقات غير المصممة لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barrierefreiheitsgrößen können in Apps, die nicht dafür ausgelegt sind, zu Layoutproblemen führen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los tamaños de accesibilidad pueden causar problemas de diseño en apps que no están preparadas para ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les tailles d’accessibilité peuvent provoquer des problèmes de mise en page dans les apps qui ne les prennent pas en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le dimensioni di accessibilità possono causare problemi di layout nelle app non progettate per supportarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクセシビリティサイズは、対応していないAppでレイアウトの問題を引き起こすことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "손쉬운 사용 크기는 이를 고려하지 않은 앱에서 레이아웃 문제를 일으킬 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toegankelijkheidsformaten kunnen lay-outproblemen veroorzaken in apps die daar niet op zijn ontworpen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os tamanhos de acessibilidade podem causar problemas de layout em apps que não foram projetados para eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Размеры для универсального доступа могут нарушить вёрстку в приложениях, не рассчитанных на них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "辅助功能字号可能会导致未针对其设计的App出现布局问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輔助使用字級可能會導致未針對其設計的App出現版面問題。"
          }
        }
      }
    },
