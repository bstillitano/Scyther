    "This app declares no localisations beyond its base language, so there is nothing to switch to.": {
      "comment": "Footer beneath the language list when the host app has no localisations",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُعلن هذا التطبيق عن أي ترجمات خارج لغته الأساسية، لذا لا يوجد ما يمكن التبديل إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese App deklariert keine Lokalisierungen über ihre Basissprache hinaus, es gibt also nichts, wohin gewechselt werden könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta app no declara localizaciones más allá de su idioma base, así que no hay nada a lo que cambiar."
          }
        },
        "fr": {
          "stringUnit": {
