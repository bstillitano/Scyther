            "value": "%@ · %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld"
          }
        }
      }
    },
    "%@ × %@pt, under Apple's 44 × 44pt guidance.": {
      "comment": "Detail of a touch-target warning finding: %@ is the measured width and %@ the measured height, both already formatted with one decimal place. 44 x 44pt is Apple's Human Interface Guidelines recommendation, not a standard.",
      "localizations": {
        "ar": {
