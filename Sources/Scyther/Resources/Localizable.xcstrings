    "Percentiles need at least five completed requests to mean anything, so the raw durations are shown instead.": {
      "comment": "Summary section footer shown when the sample is too small for percentiles",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تعني المئينات شيئًا قبل اكتمال خمسة طلبات على الأقل، لذا تُعرض المدد الأولية بدلًا منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perzentile sind erst ab fünf abgeschlossenen Anfragen aussagekräftig, daher werden stattdessen die Rohwerte gezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los percentiles solo tienen sentido a partir de cinco solicitudes completadas, así que se muestran las duraciones sin procesar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les centiles n'ont de sens qu'à partir de cinq requêtes terminées ; les durées brutes sont affichées à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I percentili hanno senso solo da cinque richieste completate in su, quindi vengono mostrate le durate grezze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パーセンタイルは完了したリクエストが5件以上ないと意味がないため、代わりに実測値を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "백분위수는 완료된 요청이 다섯 개 이상일 때만 의미가 있으므로 대신 실제 소요 시간을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Percentielen zeggen pas iets vanaf vijf voltooide verzoeken, dus worden de ruwe duren getoond."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os percentis só fazem sentido a partir de cinco solicitações concluídas, então as durações brutas são mostradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Процентили имеют смысл минимум при пяти завершённых запросах, поэтому вместо них показаны исходные длительности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "百分位数至少需要五个已完成的请求才有意义，因此这里改为显示原始时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "百分位數至少需要五個已完成的請求才有意義，因此這裡改為顯示原始時長。"
          }
        }
      }
    },
