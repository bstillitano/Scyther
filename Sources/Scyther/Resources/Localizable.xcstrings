            "value": "Deze app declareert geen lokalisaties buiten de basistaal, dus er is niets om naar over te schakelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este app não declara localizações além do idioma base, portanto não há para o que alternar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это приложение не объявляет локализаций помимо базового языка, поэтому переключаться не на что."
          }
        },
        "zh-Hans": {
          "stringUnit": {
