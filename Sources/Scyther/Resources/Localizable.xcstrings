    "Applies to every request Scyther intercepts. An override with its own condition takes precedence.": {
      "comment": "Footer explaining the scope of global conditioning and that overrides beat it",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينطبق على كل طلب يعترضه Scyther. يسبق التجاوز الذي يحمل شرطه الخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gilt für jede von Scyther abgefangene Anfrage. Ein Override mit eigener Bedingung hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se aplica a todas las solicitudes que Scyther intercepta. Una anulación con su propia condición tiene prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S'applique à toutes les requêtes interceptées par Scyther. Une surcharge dotée de sa propre condition est prioritaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si applica a ogni richiesta intercettata da Scyther. Una sostituzione con una propria condizione ha la precedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scyther が傍受するすべてのリクエストに適用されます。独自の条件を持つオーバーライドが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scyther가 가로채는 모든 요청에 적용됩니다. 자체 조건을 가진 재정의가 우선합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geldt voor elke aanvraag die Scyther onderschept. Een override met een eigen conditie heeft voorrang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplica-se a todas as requisições interceptadas pelo Scyther. Uma substituição com condição própria tem precedência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Применяется ко всем запросам, которые перехватывает Scyther. Переопределение с собственным условием имеет приоритет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "适用于 Scyther 拦截的每个请求。带有自身条件的覆盖规则优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "適用於 Scyther 攔截的每個請求。帶有自身條件的覆寫規則優先。"
          }
        }
      }
    },
