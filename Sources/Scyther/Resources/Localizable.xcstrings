    "Pads text to about 135%, the expansion German and Finnish bring.": {
      "comment": "Subtitle under the Lengthened switch explaining the expansion ratio",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمدّ النص إلى نحو ١٣٥٪، وهي نسبة التمدد التي تجلبها الألمانية والفنلندية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlängert Text auf rund 135 %, die Ausdehnung, die Deutsch und Finnisch mitbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alarga el texto hasta cerca del 135 %, la expansión que traen el alemán y el finés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rallonge le texte à environ 135 %, l’expansion qu’apportent l’allemand et le finnois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allunga il testo a circa il 135%, l’espansione che portano tedesco e finlandese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "テキストを約135%に伸ばします。ドイツ語やフィンランド語で生じる伸長率です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트를 약 135%로 늘립니다. 독일어와 핀란드어에서 나타나는 확장 비율입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlengt tekst tot ongeveer 135%, de uitbreiding die Duits en Fins met zich meebrengen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alonga o texto para cerca de 135%, a expansão que o alemão e o finlandês trazem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удлиняет текст примерно до 135% — так расширяются немецкий и финский."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将文本加长到约135%，即德语和芬兰语带来的膨胀比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將文字加長至約135%，即德語和芬蘭語帶來的膨脹比例。"
          }
        }
      }
    },
