    "The app is waiting on these. Each one continues unchanged when its timeout runs out.": {
      "comment": "Footer under the list of held requests",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التطبيق ينتظر هذه العمليات. وستتابع كل واحدة دون تغيير عند انتهاء مهلتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die App wartet darauf. Jeder Eintrag wird nach Ablauf seines Zeitlimits unverändert fortgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La app está esperando estos. Cada uno continuará sin cambios cuando venza su tiempo límite."
