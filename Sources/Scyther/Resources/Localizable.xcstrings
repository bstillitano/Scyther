    "Mock, redirect, rewrite or slow down matching requests. Add an override to get started.": {
      "comment": "Empty state description on the request overrides list",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بمحاكاة الطلبات المطابقة أو إعادة توجيهها أو إعادة كتابتها أو إبطائها. أضف تجاوزًا للبدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passende Anfragen simulieren, umleiten, umschreiben oder verlangsamen. Fügen Sie ein Override hinzu, um zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simula, redirige, reescribe o ralentiza las solicitudes coincidentes. Añade una anulación para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulez, redirigez, réécrivez ou ralentissez les requêtes correspondantes. Ajoutez un remplacement pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simula, reindirizza, riscrivi o rallenta le richieste corrispondenti. Aggiungi un override per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一致するリクエストをモック、リダイレクト、書き換え、または遅延させます。上書きを追加して始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일치하는 요청을 모의 응답, 리디렉션, 재작성하거나 지연시킵니다. 재정의를 추가해 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simuleer, verwijs door, herschrijf of vertraag passende verzoeken. Voeg een overschrijving toe om te beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simule, redirecione, reescreva ou desacelere as solicitações correspondentes. Adicione uma substituição para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подменяйте, перенаправляйте, изменяйте или замедляйте подходящие запросы. Добавьте переопределение, чтобы начать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对匹配的请求进行模拟、重定向、重写或限速。添加一条覆盖即可开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "對符合的請求進行模擬、重新導向、重寫或限速。新增一條覆寫即可開始。"
          }
        }
      }
    },
