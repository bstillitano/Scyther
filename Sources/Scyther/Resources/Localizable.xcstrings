    "%lld of %lld requests on a shared axis, oldest first. Bars that overlap were in flight at the same time.": {
      "comment": "Caption under the bars on the full-log waterfall page when a filter is active: the shown count against the unfiltered total. Not a plural entry: a String Catalog inflects on the first number, which here is the filtered count rather than the number the noun agrees with",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld من %lld طلب على محور مشترك، الأقدم أولاً. الأشرطة المتداخلة كانت قيد التنفيذ في الوقت نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld von %lld Anfragen auf einer gemeinsamen Achse, älteste zuerst. Überlappende Balken waren gleichzeitig unterwegs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld de %lld solicitudes en un eje compartido, de la más antigua a la más reciente. Las barras que se solapan estaban en curso al mismo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld requêtes sur %lld sur un axe partagé, de la plus ancienne à la plus récente. Les barres qui se chevauchent étaient en cours en même temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld di %lld richieste su un asse condiviso, dalla più vecchia alla più recente. Le barre che si sovrappongono erano in corso nello stesso momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 件中 %lld 件のリクエストを共有の軸上に、古い順に表示します。重なり合うバーは同時に実行中でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld개 중 %lld개 요청을 공유 축에 오래된 순으로 표시합니다. 겹치는 막대는 동시에 진행 중이었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld van %lld verzoeken op een gedeelde as, oudste eerst. Balken die elkaar overlappen liepen tegelijkertijd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld de %lld solicitações em um eixo compartilhado, da mais antiga para a mais recente. As barras que se sobrepõem estavam em andamento ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld из %lld запросов на общей оси, от самых старых. Пересекающиеся полосы выполнялись одновременно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 个请求（共 %lld 个）在同一时间轴上，最早的在最上方。重叠的条形表示这些请求同时在进行。"
          }
        },
        "zh-Hant": {
