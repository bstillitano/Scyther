    "Swaps letters for accented look-alikes. Anything still in plain ASCII was never localised.": {
      "comment": "Subtitle under the Accented switch explaining what it reveals",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستبدل الحروف بأشباهها المزودة بعلامات التشكيل. أي نص يبقى بترميز ASCII البسيط لم يُترجم قط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ersetzt Buchstaben durch akzentuierte Doppelgänger. Was noch reines ASCII ist, wurde nie lokalisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sustituye las letras por sosias acentuados. Todo lo que siga en ASCII simple nunca se localizó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplace les lettres par des sosies accentués. Tout ce qui reste en ASCII simple n’a jamais été localisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sostituisce le lettere con sosia accentati. Tutto ciò che resta in ASCII semplice non è mai stato localizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字をアクセント付きの類似文字に置き換えます。プレーンASCIIのままの文字列はローカライズされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문자를 악센트가 붙은 유사 문자로 바꿉니다. 여전히 순수 ASCII인 문자열은 현지화된 적이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vervangt letters door gelijkende letters met accenten. Alles wat nog gewone ASCII is, is nooit gelokaliseerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Troca as letras por sósias acentuados. Tudo que continuar em ASCII simples nunca foi localizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заменяет буквы похожими символами с диакритикой. Всё, что осталось обычным ASCII, никогда не локализовалось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将字母替换为带重音符号的相似字符。仍为纯ASCII的文本从未本地化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將字母替換為帶重音符號的相似字元。仍為純ASCII的文字從未被本地化。"
          }
        }
      }
