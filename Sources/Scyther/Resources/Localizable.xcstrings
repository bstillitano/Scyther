    "No SQLite databases were found in this app's container. If using a custom database, register an adapter with Scyther.database.registerAdapter().": {
      "comment": "Empty state description on the database list",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم العثور على قواعد بيانات SQLite في حاوية هذا التطبيق. إذا كنت تستخدم قاعدة بيانات مخصصة، فسجّل مهايئًا باستخدام Scyther.database.registerAdapter()."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Container dieser App wurden keine SQLite-Datenbanken gefunden. Registrieren Sie bei einer eigenen Datenbank einen Adapter mit Scyther.database.registerAdapter()."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se encontraron bases de datos SQLite en el contenedor de esta app. Si usas una base de datos personalizada, registra un adaptador con Scyther.database.registerAdapter()."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune base de données SQLite n'a été trouvée dans le conteneur de cette app. Si vous utilisez une base de données personnalisée, enregistrez un adaptateur avec Scyther.database.registerAdapter()."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun database SQLite trovato nel contenitore di questa app. Se usi un database personalizzato, registra un adattatore con Scyther.database.registerAdapter()."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このAppのコンテナにSQLiteデータベースが見つかりませんでした。カスタムデータベースを使用している場合は、Scyther.database.registerAdapter() でアダプタを登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 App의 컨테이너에서 SQLite 데이터베이스를 찾을 수 없습니다. 사용자 정의 데이터베이스를 사용하는 경우 Scyther.database.registerAdapter()로 어댑터를 등록하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er zijn geen SQLite-databases gevonden in de container van deze app. Registreer bij een eigen database een adapter met Scyther.database.registerAdapter()."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum banco de dados SQLite foi encontrado no contêiner deste app. Se você usa um banco de dados personalizado, registre um adaptador com Scyther.database.registerAdapter()."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В контейнере этого приложения не найдено баз данных SQLite. Если используется собственная база данных, зарегистрируйте адаптер через Scyther.database.registerAdapter()."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 App 的容器中未找到 SQLite 数据库。如果使用自定义数据库，请通过 Scyther.database.registerAdapter() 注册适配器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 App 的容器中找不到 SQLite 資料庫。若使用自訂資料庫，請透過 Scyther.database.registerAdapter() 註冊配接器。"
          }
        }
      }
