{
  "sourceLanguage": "en",
  "strings": {
    "%@ at %@, %@": {
      "comment": "Fallback name for an element with no accessibility label: %@ is the element's type name, then its x and y position in points, already formatted",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ عند %@، %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bei %@, %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ en %@, %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ à %@, %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a %@, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@（位置: %@, %@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (위치: %@, %@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bij %@, %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ em %@, %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ в позиции %@, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 位于 %@，%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 位於 %@，%@"
          }
        }
      }
    },
    "%@ may change data on the server a second time.": {
      "comment": "Message of the replay confirmation alert, naming the HTTP method",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد يغيّر %@ بيانات الخادم مرة ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kann Daten auf dem Server ein zweites Mal ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ puede cambiar datos en el servidor por segunda vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ peut modifier des données sur le serveur une seconde fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ può modificare i dati sul server una seconda volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ はサーバー上のデータを二度目に変更する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 서버의 데이터를 한 번 더 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kan gegevens op de server een tweede keer wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ pode alterar dados no servidor uma segunda vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ может изменить данные на сервере во второй раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可能会再次更改服务器上的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可能會再次變更伺服器上的資料。"
          }
        }
      }
    },
    "%@ measured at %@.": {
      "comment": "Footer line on the accessibility audit report naming what the pass checked and when: the first %@ is the list of checks that ran, the second is a locale-formatted time of day",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم قياس %@ في %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ um %@ gemessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ medido a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ mesuré à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ misurato alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@を%@に測定しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@을(를) %@에 측정했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ gemeten om %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ medido às %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ измерено в %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 于 %@ 测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 於 %@ 測量。"
          }
        }
      }
    },
    "%@ not measured while Scyther is covering the app: the colors behind this screen are Scyther's, not your app's. Switch on %@ and tap the count pill over your app to measure the real screen.": {
      "comment": "Banner on the accessibility audit report: the first %@ is the list of checks that were skipped (in practice 'Contrast'), the second is the localized title of the 'Show Issues On Screen' toggle",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم قياس %@ أثناء تغطية Scyther للتطبيق: الألوان خلف هذه الشاشة تخص Scyther وليس تطبيقك. فعّل %@ ثم اضغط على شارة العدد فوق تطبيقك لقياس الشاشة الحقيقية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nicht gemessen, solange Scyther die App überdeckt: Die Farben hinter diesem Bildschirm gehören Scyther, nicht Ihrer App. Aktivieren Sie %@ und tippen Sie auf die Zähler-Pille über Ihrer App, um den echten Bildschirm zu messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no se ha medido mientras Scyther cubre la app: los colores detrás de esta pantalla son de Scyther, no de tu app. Activa %@ y toca la píldora de recuento sobre tu app para medir la pantalla real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non mesuré tant que Scyther recouvre l'app : les couleurs derrière cet écran sont celles de Scyther, pas celles de votre app. Activez %@ puis touchez la pastille de comptage au-dessus de votre app pour mesurer l'écran réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non misurato mentre Scyther copre l'app: i colori dietro questa schermata sono di Scyther, non della tua app. Attiva %@ e tocca il badge del conteggio sopra la tua app per misurare la schermata reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scytherがアプリを覆っている間、%@は測定されません。この画面の背後の色はアプリではなくScytherのものです。%@をオンにし、アプリ上の件数ピルをタップすると実際の画面を測定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scyther가 앱을 덮고 있는 동안에는 %@을(를) 측정하지 않습니다. 이 화면 뒤의 색은 앱이 아니라 Scyther의 것입니다. %@을(를) 켜고 앱 위의 개수 알약을 탭하면 실제 화면을 측정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ niet gemeten terwijl Scyther de app bedekt: de kleuren achter dit scherm zijn die van Scyther, niet van je app. Schakel %@ in en tik op de tellerpil boven je app om het echte scherm te meten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não foi medido enquanto o Scyther cobre o app: as cores atrás desta tela são do Scyther, não do seu app. Ative %@ e toque na pílula de contagem sobre o seu app para medir a tela real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не измеряется, пока Scyther закрывает приложение: цвета за этим экраном принадлежат Scyther, а не вашему приложению. Включите %@ и нажмите на счётчик поверх приложения, чтобы измерить настоящий экран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scyther 覆盖应用时不测量 %@：此屏幕背后的颜色属于 Scyther，而非你的应用。开启%@并点按应用上方的计数标签即可测量真实屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scyther 覆蓋應用程式時不測量 %@：此畫面背後的顏色屬於 Scyther，而非你的應用程式。開啟%@並點一下應用程式上方的計數標籤即可測量真實畫面。"
          }
        }
      }
    },
    "%@ ran but could not read enough of this screen to report on it. What it did not measure is missing from this report, not passing it.": {
      "comment": "Banner on the accessibility audit report: %@ is the list of checks that ran but could read too little of the screen to have run (in practice 'Contrast'). Covers all three causes: the screen could not be captured, it was captured but nothing was legible, or too few elements were legible.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تشغيل %@ لكنه لم يتمكن من قراءة ما يكفي من هذه الشاشة لإعداد تقرير عنها. ما لم يُقَس غائب عن هذا التقرير، وليس ناجحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ lief, konnte aber nicht genug von diesem Bildschirm lesen, um darüber zu berichten. Was nicht gemessen wurde, fehlt in diesem Bericht — es ist nicht bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se ejecutó, pero no pudo leer lo suficiente de esta pantalla para informar sobre ella. Lo que no se midió falta en este informe; no está aprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ s'est exécuté mais n'a pas pu lire assez de cet écran pour en rendre compte. Ce qui n'a pas été mesuré est absent de ce rapport, pas validé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ è stato eseguito ma non è riuscito a leggere abbastanza di questa schermata per riferirne. Ciò che non è stato misurato manca da questo rapporto, non è stato approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@は実行されましたが、この画面を十分に読み取れず報告できませんでした。測定できなかった部分はこのレポートに含まれていません。合格したわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 실행되었지만 이 화면을 충분히 읽지 못해 보고할 수 없습니다. 측정하지 못한 부분은 이 보고서에 없을 뿐, 통과한 것이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is uitgevoerd maar kon te weinig van dit scherm lezen om erover te rapporteren. Wat niet is gemeten ontbreekt in dit rapport; het is niet goedgekeurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ foi executado, mas não conseguiu ler o suficiente desta tela para relatá-la. O que não foi medido está ausente deste relatório, não aprovado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ выполнилась, но не смогла прочитать достаточную часть экрана, чтобы сделать вывод. То, что не измерено, отсутствует в отчёте, а не пройдено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@已运行，但无法读取此界面的足够内容来给出结论。未测量的部分只是不在本报告中，并不代表通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@已執行，但無法讀取此畫面的足夠內容來給出結論。未測量的部分只是不在本報告中，並不代表通過。"
          }
        }
      }
    },
    "%@ read %lld of %lld elements on this screen. What it did not measure is missing from this report, not passing it.": {
      "comment": "Banner on the accessibility audit report: %@ is the list of checks that read only part of the screen (in practice 'Contrast'), the first %lld is how many elements the check could read and the second how many it was asked about (always two or more). Its second sentence is deliberately identical to the 'ran but could not read enough' banner's.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قرأ %@ %lld عنصرًا من أصل %lld في هذه الشاشة. ما لم يُقَس غائب عن هذا التقرير، وليس ناجحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat %lld von %lld Elementen auf diesem Bildschirm gelesen. Was nicht gemessen wurde, fehlt in diesem Bericht — es ist nicht bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha leído %lld de %lld elementos de esta pantalla. Lo que no se midió falta en este informe; no está aprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a lu %lld des %lld éléments de cet écran. Ce qui n'a pas été mesuré est absent de ce rapport, pas validé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha letto %lld elementi su %lld in questa schermata. Ciò che non è stato misurato manca da questo rapporto, non è stato approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@はこの画面の要素 %lld 個（全 %lld 個中）を読み取りました。測定できなかった部分はこのレポートに含まれていません。合格したわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 이 화면의 요소 %lld개(전체 %lld개)를 읽었습니다. 측정하지 못한 부분은 이 보고서에 없을 뿐, 통과한 것이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft %lld van de %lld elementen op dit scherm gelezen. Wat niet is gemeten ontbreekt in dit rapport; het is niet goedgekeurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ leu %lld de %lld elementos desta tela. O que não foi medido está ausente deste relatório, não aprovado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ прочитала %lld из %lld элементов на этом экране. То, что не измерено, отсутствует в отчёте, а не пройдено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@已读取此界面 %lld 个元素（共 %lld 个）。未测量的部分只是不在本报告中，并不代表通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@已讀取此畫面 %lld 個元素（共 %lld 個）。未測量的部分只是不在本報告中，並不代表通過。"
          }
        }
      }
    },
    "%@ was not run in this pass. Tap %@ to include it.": {
      "comment": "Banner on the accessibility audit report: the first %@ is the list of checks that are switched on but were not part of this pass (either switched on since it ran, or deferred because a live pass does not run contrast), the second is the localized title of the Re-run toolbar button",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم تشغيل %@ في هذا المسح. اضغط %@ لتضمينه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wurde in diesem Durchlauf nicht ausgeführt. Tippen Sie auf %@, um es einzubeziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no se ejecutó en esta pasada. Toca %@ para incluirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n'a pas été exécuté lors de ce passage. Touchez %@ pour l'inclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non è stato eseguito in questa scansione. Tocca %@ per includerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このパスでは%@は実行されていません。%@をタップすると結果に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 검사에서는 %@이(가) 실행되지 않았습니다. %@을(를) 탭하면 결과에 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is niet uitgevoerd in deze ronde. Tik op %@ om het mee te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não foi executado nesta passagem. Toque em %@ para incluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не выполнялось в этом проходе. Нажмите %@, чтобы включить в него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本次检查未运行 %@。点按%@即可将其纳入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本次檢查未執行 %@。點一下%@即可將其納入。"
          }
        }
      }
    },
    "%@ · %lld": {
      "comment": "Filter chip title when several values are selected; %@ is the dimension title and %lld the count",
      "localizations": {
        "ar": {
          "stringUnit": {
