    "Continuing applies your edits. The log records the exchange as the app actually saw it.": {
      "comment": "Footer under the Continue Without Changes and Abort buttons",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المتابعة تطبّق تعديلاتك. ويسجّل السجل العملية كما رآها التطبيق فعليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsetzen übernimmt Ihre Änderungen. Das Protokoll hält den Austausch so fest, wie die App ihn tatsächlich gesehen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar aplica tus cambios. El registro guarda el intercambio tal como lo vio la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuer applique vos modifications. Le journal enregistre l'échange tel que l'app l'a réellement vu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuando vengono applicate le modifiche. Il log registra lo scambio così come l'app lo ha effettivamente visto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "続行すると編集内容が適用されます。ログにはアプリが実際に受け取った内容が記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계속하면 편집 내용이 적용됩니다. 로그에는 앱이 실제로 본 교신이 기록됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doorgaan past je wijzigingen toe. Het logboek legt de uitwisseling vast zoals de app die echt zag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar aplica suas edições. O log registra a troca como o app realmente a viu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продолжение применяет ваши правки. В журнале обмен записывается таким, каким его увидело приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
